# ── FoodMap Environment Variables ─────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Spring ────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8082

# ── Database ──────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5434/foodmap_dev
DB_USERNAME=foodmap
DB_PASSWORD=foodmap

# ── JPA ───────────────────────────────────────────────────
# Values: create | create-drop | update | validate | none
JPA_DDL_AUTO=update

# ── JWT ───────────────────────────────────────────────────
# Secret MUST be at least 32 bytes (256 bits) for HS256. The value is used as
# raw UTF-8 bytes (it is not Base64-decoded). The backend refuses to start with
# a shorter secret, and the prod profile also rejects this placeholder.
# Generate a strong secret (64 characters): openssl rand -base64 48
JWT_SECRET=replace-this-with-a-strong-random-secret-minimum-32-characters
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# ── Dev seed data ─────────────────────────────────────────
# Password for the demo accounts DataSeeder creates (dev profile, empty database only).
# Pick your own, 8–100 characters. Never reuse a real password.
SEED_DEMO_PASSWORD=change-me-dev-demo-password

# ── Goong Maps ────────────────────────────────────────────
# Obtain keys from https://account.goong.io
GOONG_API_KEY=your_goong_api_key_here
GOONG_MAP_KEY=your_goong_map_key_here

# ── CORS ──────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── App Settings ──────────────────────────────────────────
RESTAURANT_SYNC_TTL_DAYS=7
